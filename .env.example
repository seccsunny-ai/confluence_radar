# Postgres connection string (Neon via the Vercel Marketplace sets DATABASE_URL automatically)
DATABASE_URL=postgres://user:pass@host/db
# Free Google Gemini key from https://aistudio.google.com/apikey, used to read the screenshots
GEMINI_API_KEY=
# Optional: Gemini model (default gemini-3.8-flash)
GEMINI_MODEL=
# Optional alternative reader: Anthropic API key (paid). Used only when GEMINI_API_KEY is not set.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5-5
EXTRACTION_EFFORT=medium
# Optional: require this password (HTTP Basic auth, any username) to open the app
APP_PASSWORD=
# Telegram alerts: bot token from @BotFather. The chat is found from the Telegram tab (or set TELEGRAM_CHAT_ID).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Shared secret the scheduled check (GitHub Actions) sends as "Authorization: Bearer ..." to get past APP_PASSWORD
CRON_SECRET=
# Optional: timezone for times in Telegram alerts (default Asia/Kolkata)
ALERT_TZ=
